# Cross-species (finch/chicken/yao) integration analysis -- bulk data and
# intermediate outputs regenerated by this directory's own scripts. Driver
# scripts (.py/.R/.sbatch) at every level stay tracked; only their raw/
# intermediate inputs and outputs are excluded here.

__pycache__/
.~lock.*#

# Per-dataset working dirs (datasets/<pair>/{data,analysis,results*,train,logs}):
# raw count exports, SATURN/SAMap embeddings and objects, SLURM logs.
datasets/*/data/
datasets/*/analysis/
datasets/*/results/
datasets/*/results_*/
datasets/*/train/
datasets/*/maps/
datasets/*/logs/

# Composite-scoring ensemble: raw matrix exports and OrthoFinder's own
# intermediate BLAST/alignment output (regenerate via run_orthofinder_bfgg_adult.sbatch).
composite_scoring/data/
composite_scoring/orthofinder_bfgg_adult/

# RPCA/CCA sweep: raw per-k.anchor integrated-embedding matrices.
rpca_sweep/data/

logs/
